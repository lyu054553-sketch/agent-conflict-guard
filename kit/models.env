# 每个角色用哪个模型。
# 主控是 Claude Opus 5.5（claude-opus-5-5），在 T3 Code 的 Claude 会话里选择，不在这里配置。
#
# 以 agy: 开头的走 Antigravity 命令行，查看可用名字：agy models
# 其余走 Codex，可用名字见 ~/.codex/magpie-desktop-models.json
# 临时换模型：在命令前加环境变量，例如 MODEL_BACKEND_EASY=auto/kimi-k3.1-pro scripts/agents/ask.sh ...

# 独立出一份方案 — Gemini 4 Neon (High)
: "${MODEL_PLAN:=agy:gemini-4-neon-high}"
# 审交互 — Gemini 4 Neon (High)
: "${MODEL_UX:=agy:gemini-4-neon-high}"

# 审中文文案 — Kimi K3.1 Pro
: "${MODEL_COPY_CN:=auto/kimi-k3.1-pro}"

# 难的后端 — GPT-6.2-Astra
: "${MODEL_BACKEND_HARD:=gpt-6.2-astra}"
# 标准清楚的成块后端 — MiniMax-M3
: "${MODEL_BACKEND_EASY:=minimax-cn/MiniMax-M3}"

# 合并前预审 — DeepSeek V4.1 Flash
: "${MODEL_PRE_REVIEW:=auto/deepseek-v4.1-flash}"
# 最终审查（最多 2 轮）— GPT-6.2-Sol
: "${MODEL_FINAL_REVIEW:=gpt-6.2-sol}"

# 杂活：PR 描述、更新日志、文档、线上日志初筛 — MiniMax-M3.1-Flash
: "${MODEL_CHORES:=minimax-cn/MiniMax-M3.1-Flash}"
